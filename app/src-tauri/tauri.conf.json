{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevKit",
  "version": "0.1.0",
  "identifier": "local.devkit.app",
  "build": {
    "beforeDevCommand": "node scripts/ensure-mcp-resource.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/stage-mcp.mjs && node scripts/stage-stack.mjs",
    "frontendDist": "../dist"
  },
    "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevKit",
        "width": 1080,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/devkit-mcp.exe": "devkit-mcp.exe",
      "resources/devkit.exe": "devkit.exe"
    },
    "windows": {
      "nsis": {
        "template": "./windows/installer.nsi",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
